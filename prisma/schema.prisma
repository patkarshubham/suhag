// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  tagline     String
  description String
  image       String
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  image       String
  // JSON-encoded string[] — kept as JSON text (not a native array) so this
  // schema is portable between SQLite (dev) and Postgres (prod on Vercel).
  gallery     String
  highlights  String
  badge       String?
  // Prices are in paise (1/100 INR), matching Stripe's smallest-unit
  // convention. Both are nullable: products with no price set stay
  // "enquire only" (no cart/buy button); setting a price turns on
  // MRP/discount display and Add to Cart.
  mrp         Int?
  price       Int?
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  cartItems   CartItem[]
  savedItems  SavedItem[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model User {
  id           String      @id @default(cuid())
  name         String?
  email        String?     @unique
  phone        String?     @unique
  passwordHash String?
  addresses    Address[]
  cartItems    CartItem[]
  savedItems   SavedItem[]
  orders       Order[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

// Phone sign-in codes. Sending is stubbed (logged to the server console)
// until an SMS provider (Twilio/MSG91/etc.) is configured — see src/lib/otp.ts.
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  addressSnapshot String // JSON snapshot of the shipping address at order time
  subtotal        Int
  total           Int
  status          String      @default("pending") // pending | paid | failed | cancelled
  stripeSessionId String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String // snapshot at purchase time
  image     String // snapshot at purchase time
  price     Int // snapshot unit price (paise) at purchase time
  quantity  Int
}
